                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
                AutoButtonColor = false, ZIndex = 4,
            }, icon)
            hit.MouseButton1Click:Connect(function()
                playClick(1.2)
                if pin.toggle then pin.toggle(entry) end
            end)
        end
        table.insert(g.rows, entry)
        return row, line1, firstH, icon
    end
    return newGroup, newRow, groups
end

-- Slider ala iOS ------------------------------------------------------------
local function makeSlider(parent, pos, size, min, max, default, onChange, onDisplay, onCommit)
    local hit = make("TextButton", {
        Size = size, Position = pos, BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
    }, parent)
    local rail = make("Frame", {
        Size = UDim2.new(1, 0, 0, 6), Position = UDim2.new(0, 0, 0.5, -3),
        BackgroundColor3 = "@BTN", BackgroundTransparency = 0.7, BorderSizePixel = 0,
    }, hit)
    corner(rail, PILL)
    local fill = make("Frame", {
        Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = "@ACCENT", BorderSizePixel = 0,
    }, rail)
    corner(fill, PILL)
    local knob = make("Frame", {
        Size = UDim2.fromOffset(22, 22), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, hit)
    corner(knob, PILL)
    make("UIStroke", { Color = Color3.new(0, 0, 0), Transparency = 0.82, Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, knob)
    local ks = make("UIScale", {}, knob)

    local obj = { value = default }
    -- [SMOOTH] fill & knob mengikuti dengan tween pendek (bukan lompat)
    function obj.set(v, silent, animate)
        obj.value = v
        local a = math.clamp((v - min) / (max - min), 0, 1)
        local t = animate and 0.3 or 0.07
        tw(fill, t, { Size = UDim2.new(a, 0, 1, 0) }, Enum.EasingStyle.Sine)
        tw(knob, t, { Position = UDim2.new(a, 0, 0.5, 0) }, Enum.EasingStyle.Sine)
        if onDisplay then onDisplay(v) end
        if not silent and onChange then onChange(v) end
    end

    local dragging = false
    local function fromX(x)
        local w = hit.AbsoluteSize.X
        if w <= 0 then return end
        local a = math.clamp((x - hit.AbsolutePosition.X) / w, 0, 1)
        obj.set(math.floor(min + (max - min) * a + 0.5))
    end
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            playClick(1.3)
            tw(ks, 0.2, { Scale = 1.25 }, Enum.EasingStyle.Back)
            fromX(input.Position.X)
        end
    end)
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            fromX(input.Position.X)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            tw(ks, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
            if onCommit then onCommit(obj.value) end
        end
    end))

    obj.set(default, true, false)
    return obj
end

-- Baris kedua: slider + kotak angka (bisa diketik, nilai di luar rentang slider tetap diterima)
local function addSlider(row, firstH, min, max, default, onChange, onCommit)
    local box
    local sl = makeSlider(row, UDim2.new(0, 50, 0, firstH + 2), UDim2.new(1, -132, 0, 24),
        min, max, default, onChange,
        function(v) if box then box.Text = tostring(v) end end, onCommit)
    box = textbox(row, {
        Size = UDim2.new(0, 56, 0, 24), AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, firstH + 2), Text = tostring(default),
        TextXAlignment = Enum.TextXAlignment.Center,
    })
    box.FocusLost:Connect(function()
        local v = tonumber(box.Text)
        if v then
            sl.set(v, false, true)
            if onCommit then onCommit(v) end
        else
            box.Text = tostring(sl.value)
        end
    end)
    return sl
end

