-- Efek suara klik (pitch opsional: >1 lebih tinggi, <1 lebih rendah)
local SoundService = game:GetService("SoundService")
-- Gaya suara klik: pitch (tinggi nada), len (detik), vol (pengali volume),
-- notes (rangkaian nada, pengali pitch) dan gap (jeda antar nada)
local SOUND_STYLES = {
    Tik    = { pitch = 1.6,  len = 0.12, vol = 1.0 },
    Pop    = { pitch = 0.8,  len = 0.16, vol = 1.0 },
    Soft   = { pitch = 1.1,  len = 0.22, vol = 0.6 },
    Bubble = { pitch = 1.2,  len = 0.14, vol = 0.9, notes = { 1, 1.45 }, gap = 0.05 },
    Chime  = { pitch = 1.4,  len = 0.3,  vol = 0.8, notes = { 1, 1.26, 1.5 }, gap = 0.06 },
    Deep   = { pitch = 0.55, len = 0.2,  vol = 1.0 },
}
local SOUND_ORDER = { "Tik", "Pop", "Soft", "Bubble", "Chime", "Deep" }

local function playOne(pitchMul, style)
    local s = Instance.new("Sound")
    s.Name = "HUniversalClick"
    s.SoundId = CONFIG.ClickSoundId
    s.Volume = CONFIG.SoundVolume * style.vol
    s.PlaybackSpeed = pitchMul
    s.Parent = SoundService
    s.Ended:Connect(function() s:Destroy() end)
    s:Play()
    local len = style.len
    task.delay(len * 0.5, function()
        pcall(function()
            TweenService:Create(s, TweenInfo.new(len * 0.5, Enum.EasingStyle.Sine), { Volume = 0 }):Play()
        end)
    end)
    task.delay(len, function() pcall(function() s:Destroy() end) end)
end

local function playClick(pitch, forceStyle)
    if not CONFIG.Sound and not forceStyle then return end
    pcall(function()
        local style = SOUND_STYLES[forceStyle or CONFIG.SoundStyle] or SOUND_STYLES.Tik
        local base = (pitch or 1) * style.pitch
        if style.notes then
            for i, mul in ipairs(style.notes) do
                task.delay((i - 1) * (style.gap or 0.05), function() pcall(playOne, base * mul, style) end)
            end
        else
            playOne(base, style)
        end
    end)
end

-- Tepi kaca: terang di sudut, redup di tengah (efek pantulan cahaya)
local RIM_STRONG = seq({ {0, 0.12}, {0.22, 0.68}, {0.5, 0.92}, {0.78, 0.68}, {1, 0.18} })
local RIM_SOFT   = seq({ {0, 0.5},  {0.25, 0.84}, {0.5, 0.95}, {0.75, 0.84}, {1, 0.45} })
local function rim(o, thickness, rotation, soft)
    local s = make("UIStroke", {
        Color = "@WHITE", Thickness = thickness or 1, Transparency = 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, o)
    make("UIGradient", { Rotation = rotation or 45, Transparency = soft and RIM_SOFT or RIM_STRONG }, s)
    return s
end

local function glassCard(parent, height, order)
    local f = make("Frame", {
        Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = "@PANEL",
        BackgroundTransparency = 0.89, BorderSizePixel = 0, LayoutOrder = order,
    }, parent)
    corner(f, UDim.new(0, 16))
    rim(f, 1, 45, true)
    return f
end

