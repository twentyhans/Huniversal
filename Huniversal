local function button(parent, text, accent, props)
    local baseT = accent and 0.1 or 0.84
    local b = make("TextButton", merge({
        BackgroundColor3 = accent and "@ACCENT" or "@BTN", BackgroundTransparency = baseT,
        BorderSizePixel = 0, Text = text, TextColor3 = "@TEXT", TextSize = 12,
        Font = F.Bold, AutoButtonColor = false,
    }, props), parent)
    corner(b, PILL)
    rim(b, 1, 45, true)
    local sc = make("UIScale", {}, b)
    b.MouseEnter:Connect(function() tw(b, 0.15, { BackgroundTransparency = math.max(0, baseT - 0.08) }) end)
    b.MouseLeave:Connect(function()
        tw(b, 0.2, { BackgroundTransparency = baseT })
        tw(sc, 0.2, { Scale = 1 })
    end)
    b.MouseButton1Down:Connect(function() tw(sc, 0.1, { Scale = 0.94 }) end)
    b.MouseButton1Up:Connect(function() tw(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back) end)
    return b
end

