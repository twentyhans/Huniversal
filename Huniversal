-- Properti warna yang ditulis "@KEY" otomatis ikut berubah saat tema diganti
local COLOR_PROPS = {
    BackgroundColor3 = true, TextColor3 = true, ImageColor3 = true, Color = true,
    ScrollBarImageColor3 = true, PlaceholderColor3 = true,
}
local themed, themeHooks = {}, {}

local function make(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do
        if COLOR_PROPS[k] and type(v) == "string" and v:sub(1, 1) == "@" then
            local key = v:sub(2)
            o[k] = C[key]
            themed[#themed + 1] = { o, k, key }
        else
            o[k] = v
        end
    end
    if parent then o.Parent = parent end
    return o
end

local function merge(base, extra)
    for k, v in pairs(extra or {}) do base[k] = v end
    return base
end

local function tw(o, t, props, style, dir)
    if not t or t <= 0 then
        for k, v in pairs(props) do o[k] = v end
        return
    end
    TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props):Play()
end

local function seq(points)
    local k = {}
    for i, p in ipairs(points) do k[i] = NumberSequenceKeypoint.new(p[1], p[2]) end
    return NumberSequence.new(k)
end

local function corner(o, r)
    return make("UICorner", { CornerRadius = r or UDim.new(0, 12) }, o)
end
local PILL = UDim.new(0.5, 0)

-- Tepi kaca: terang di sudut, redup di tengah (efek pantulan cahaya)
local RIM_STRONG = seq({ {0, 0.12}, {0.22, 0.68}, {0.5, 0.92}, {0.78, 0.68}, {1, 0.18} })
local RIM_SOFT   = seq({ {0, 0.5},  {0.25, 0.84}, {0.5, 0.95}, {0.75, 0.84}, {1, 0.45} })
local function rim(o, thickness, rotation, soft)
    local s = make("UIStroke", {
        Color = "@WHITE", Thickness = thickness or 1, Transparency = 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, o)
    make("UIGradient", { Rotation = rotation or 45, Transparency = soft and RIM_SOFT or RIM_STRONG }, s)
    return s
end

