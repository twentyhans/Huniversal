local DEFAULT_COLORS = {}
for k, v in pairs(CONFIG.Colors) do DEFAULT_COLORS[k] = { v[1], v[2], v[3] } end

-- Muat pengaturan tersimpan
local SAVE_FILE = "HUniversal_Glass.json"
local function readJson(name)
    local ok, raw = pcall(function()
        if not (isfile and readfile) then return nil end
        if isfile(name) then return readfile(name) end
    end)
    if ok and type(raw) == "string" then
        local okD, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if okD and type(data) == "table" then return data end
    end
end

do
    local data = readJson(SAVE_FILE)
    -- config lama hanya dipakai untuk tombol (warna lama tidak cocok dengan tema kaca)
    local src = data or readJson("HUniversal_config.json") or readJson("OpiumHub_config.json")
    if src then
        if data and type(data.Colors) == "table" then
            for key, _ in pairs(DEFAULT_COLORS) do
                local v = data.Colors[key]
                if type(v) == "table" and type(v[1]) == "number"
                    and type(v[2]) == "number" and type(v[3]) == "number" then
                    CONFIG.Colors[key] = {
                        math.clamp(math.floor(v[1]), 0, 255),
                        math.clamp(math.floor(v[2]), 0, 255),
                        math.clamp(math.floor(v[3]), 0, 255),
                    }
                end
            end
        end
        if data then
            if type(data.GlassTransparency) == "number" then
                CONFIG.GlassTransparency = math.clamp(data.GlassTransparency, 0, 0.95)
            end
            if type(data.Blur) == "boolean" then CONFIG.Blur = data.Blur end
        end
        if type(src.ToggleKey) == "string" then CONFIG.ToggleKey = src.ToggleKey end
        if type(src.Keybinds) == "table" then
            for id, _ in pairs(CONFIG.Keybinds) do
                local n = src.Keybinds[id]
                if type(n) == "string" then
                    local okE, kc = pcall(function() return Enum.KeyCode[n] end)
                    if n == "" or (okE and kc) then CONFIG.Keybinds[id] = n end
                end
            end
        end
    end
end

