    pcall(Splash.destroy)
    stopFly()
    setNoclip(false)
    infJumpEnabled = false
    shown = false
    pcall(function() if blurEffect then blurEffect:Destroy() end end)
    for _, c in ipairs(connections) do c:Disconnect() end
    ScreenGui:Destroy()
end
