-- Keybind fitur
local State = { capturing = false, lastCapture = 0 }
local onConfigChanged = function() end
local getUiKeyName = function() return CONFIG.ToggleKey end
local featureSetters = {}
local bindButtons = {}
local capturingId = nil
local hubResetUI = function() end

local function keyDisplay(id)
    local n = CONFIG.Keybinds[id]
    return (n and n ~= "") and n or "None"
end
local function refreshBind(id)
    local bb = bindButtons[id]
    if bb then bb.Text = keyDisplay(id) end
end

track(UserInputService.InputBegan:Connect(function(input, gpe)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if capturingId then
        local id = capturingId
        capturingId = nil
        local kc = input.KeyCode
        if kc == Enum.KeyCode.Escape then
            -- batal
        elseif kc == Enum.KeyCode.Backspace or kc == Enum.KeyCode.Delete then
            CONFIG.Keybinds[id] = ""
            onConfigChanged()
            log("Keybind " .. id .. " dihapus")
        elseif kc.Name == getUiKeyName() then
            log("Tombol " .. kc.Name .. " dipakai untuk toggle UI, pilih tombol lain", "warn")
        else
            local usedBy
            for other, name in pairs(CONFIG.Keybinds) do
                if other ~= id and name == kc.Name then usedBy = other end
            end
            if usedBy then
                log("Tombol " .. kc.Name .. " sudah dipakai oleh " .. usedBy, "warn")
            else
                CONFIG.Keybinds[id] = kc.Name
                onConfigChanged()
                log("Keybind " .. id .. " = " .. kc.Name, "ok")
            end
        end
        refreshBind(id)
        State.lastCapture = os.clock()
        return
    end

    if gpe or State.capturing or (os.clock() - State.lastCapture) < 0.2 then return end
    local pressed = input.KeyCode.Name
    for id, key in pairs(CONFIG.Keybinds) do
        local f = featureSetters[id]
        if f and key ~= "" and key == pressed then
            f.set(not f.get())
            return
        end
    end
end))

local function makeListKit(Cards)
    -- Grup (inset grouped list) --------------------------------------------
    local groups, order = {}, 0
    local function newGroup(title)
        order += 1
        local header = make("TextLabel", {
            Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = title:upper(),
            TextColor3 = "@MUTED", TextSize = 11, Font = F.Bold,
            TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = order,
        }, Cards)
        make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingTop = UDim.new(0, 4) }, header)
        order += 1
        local box = make("Frame", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = "@PANEL", BackgroundTransparency = 0.89, BorderSizePixel = 0,
            LayoutOrder = order,
        }, Cards)
        corner(box, UDim.new(0, 18))
        rim(box, 1, 45, true)
        make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, box)
        local g = { header = header, box = box, rows = {} }
        table.insert(groups, g)
        return g
    end

    -- Baris: ikon + judul + (kontrol) ----------------------------------------
