            Size = UDim2.new(1, -50, 0, 1), Position = UDim2.new(0, 50, 0, 0),
            BackgroundColor3 = "@WHITE", BackgroundTransparency = 0.88, BorderSizePixel = 0,
            Visible = n > 1,
        }, row)
        local line1 = make("Frame", {
            Size = UDim2.new(1, 0, 0, firstH), BackgroundTransparency = 1,
        }, row)
        local icon = make("Frame", {
            Size = UDim2.fromOffset(28, 28), Position = UDim2.new(0, 12, 0.5, -14),
            BackgroundColor3 = plain and color or Color3.new(1, 1, 1), BorderSizePixel = 0,
        }, line1)
        corner(icon, UDim.new(0, 8))
        if not plain then
            make("UIGradient", {
                Rotation = 90, Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.28), color),
            }, icon)
        end
