        bb.MouseButton1Click:Connect(function()
            if capturingId then
                local prev = capturingId
                capturingId = nil
                refreshBind(prev)
            end
            capturingId = id
            bb.Text = "Press..."
        end)
        featureSetters[id] = { set = function(v) sw.set(v) end, get = sw.get }
        return sw
    end

