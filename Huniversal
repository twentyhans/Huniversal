local shown = true
local blurEffect
local function applyBlur()
    pcall(function()
        local want = CONFIG.Blur and shown
        if want then
            if not blurEffect or not blurEffect.Parent then
                blurEffect = Instance.new("BlurEffect")
                blurEffect.Name = "HUniversalBlur"
                blurEffect.Size = 0
                blurEffect.Parent = Lighting
            end
            tw(blurEffect, 0.3, { Size = CONFIG.BlurSize })
        elseif blurEffect and blurEffect.Parent then
