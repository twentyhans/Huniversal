local function updatePing()
    local ping = getPing()
    if not ping then
        PingLabel.Text = "-- ms"
        PingLabel.TextColor3 = C.MUTED
        for _, bar in ipairs(signalBars) do
            bar.BackgroundColor3 = Color3.new(1, 1, 1)
            bar.BackgroundTransparency = 0.7
        end
        return
    end
    local col = pingColor(ping)
    PingLabel.Text = ("%d ms"):format(math.floor(ping + 0.5))
    PingLabel.TextColor3 = col
    local n = (ping <= 60 and 4) or (ping <= 120 and 3) or (ping <= 200 and 2) or 1
    for i, bar in ipairs(signalBars) do
        bar.BackgroundColor3 = (i <= n) and col or Color3.new(1, 1, 1)
        bar.BackgroundTransparency = (i <= n) and 0 or 0.7
    end
end
