            Font = F.Bold, AutoButtonColor = false,
        }, CatBar)
        b.MouseButton1Click:Connect(function()
            if currentCat ~= name then playClick(1.1) end
            setCategory(name)
        end)
    end

    -- daftar pemain ikut diperbarui saat ada yang masuk / keluar
    track(Players.PlayerAdded:Connect(function() task.delay(0.3, renderPlayers) end))
    track(Players.PlayerRemoving:Connect(function() task.delay(0.3, renderPlayers) end))

    -- Search: sembunyikan baris & grup yang tidak cocok (kategori UNIVERSAL dan UTILITY)
    local function allGroups()
        local t = {}
        for _, g in ipairs(groups) do t[#t + 1] = g end
        for _, g in ipairs(ugroups) do t[#t + 1] = g end
        return t
    end
    local function applyFilter()
        local q = Search.Text:lower()
        for _, g in ipairs(allGroups()) do
            local any = false
            for _, r in ipairs(g.rows) do
                local vis = (q == "" or r.name:find(q, 1, true) ~= nil)
                r.frame.Visible = vis
                r.div.Visible = vis and any
                if vis then any = true end
            end
            g.header.Visible = any
            g.box.Visible = any
        end
    end
    Search:GetPropertyChangedSignal("Text"):Connect(function()
        applyFilter()
        renderPlayers()
    end)

    ------------------------------------------------------------------
    -- FAVORITES: ketuk ikon fitur untuk menyematkan ke grup paling atas
    ------------------------------------------------------------------
    local function pinSet(e, on)
        if e.pinned == on then return end
        local fav = pin.fav
        e.pinned = on
        if on then
            local i = table.find(e.group.rows, e)
            if i then table.remove(e.group.rows, i) end
            pin.counter += 1
            e.frame.LayoutOrder = pin.counter
            e.frame.Parent = fav.box
            table.insert(fav.rows, e)
        else
            local i = table.find(fav.rows, e)
            if i then table.remove(fav.rows, i) end
            e.frame.LayoutOrder = e.order
            e.frame.Parent = e.group.box
            table.insert(e.group.rows, e)
            table.sort(e.group.rows, function(a, b) return a.order < b.order end)
        end
        if e.star then e.star.Visible = on end
    end
    pin.toggle = function(e)
        pinSet(e, not e.pinned)
        local t = {}
        for _, x in ipairs(pin.fav.rows) do t[#t + 1] = x.title end
        CONFIG.Favorites = t
        applyFilter()
        onConfigChanged()
        log((e.pinned and "Disematkan ke Favorites: " or "Dilepas dari Favorites: ") .. e.title, "info")
    end
    for _, title in ipairs(CONFIG.Favorites) do
        local e = pin.entries[title]
        if e then pinSet(e, true) end
    end
    applyFilter()

    ------------------------------------------------------------------
    -- RIWAYAT PENCARIAN: muncul saat kotak search kosong dan difokuskan
    ------------------------------------------------------------------
    local Hist = make("Frame", {
        Size = UDim2.new(1, -24, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
