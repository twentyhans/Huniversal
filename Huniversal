        sheenGrad.Offset = Vector2.new(-1, 0)
        tw(sheenGrad, dur, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
        tw(IconScale, dur * 0.45, { Scale = 1.14 }, Enum.EasingStyle.Quad)
        task.delay(dur * 0.45, function()
            if Splash.alive then tw(IconScale, dur * 0.55, { Scale = 1 }, Enum.EasingStyle.Back) end
        end)
    end

    -- gelombang cincin dari titik tengah layar
    function Splash.ripple()
        local function ring(color, delay, thickness)
            task.delay(delay, function()
                if not Splash.alive then return end
                local r = make("Frame", {
                    Size = UDim2.fromOffset(100, 100), AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0,
                }, Gui)
                corner(r, PILL)
                local st = make("UIStroke", {
                    Color = color, Thickness = thickness, Transparency = 0.15,
                    ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                }, r)
                tw(r, 1, { Size = UDim2.fromOffset(1500, 1500) }, Enum.EasingStyle.Quint)
                tw(st, 1, { Transparency = 1 }, Enum.EasingStyle.Quad)
                task.delay(1.1, function() pcall(function() r:Destroy() end) end)
            end)
        end
        ring(WHITE, 0, 3)
        ring(C.ACCENT2, 0.12, 2)
    end

    function Splash.destroy()
        if not Splash.alive then return end
        Splash.alive = false
        pcall(function() Gui:Destroy() end)
        pcall(function() if blur then blur:Destroy() end end)
    end

    -- ikon melesat ke tengah & membesar jadi jendela, sisanya memudar
    function Splash.dissolve(dur)
        if not Splash.alive then return end
        orbitTarget = 0
        tw(IconG, dur, { Position = UDim2.new(0.5, 0, 0.5, 0), GroupTransparency = 1 }, Enum.EasingStyle.Quint)
        tw(IconScale, dur, { Scale = 2.8 }, Enum.EasingStyle.Quint)
        tw(LogoG, dur * 0.7, { GroupTransparency = 1 })
        tw(LogoScale, dur * 0.7, { Scale = 1.15 }, Enum.EasingStyle.Quint)
        tw(BarG, dur * 0.5, { GroupTransparency = 1 })
        tw(Glow, dur, { GroupTransparency = 1 })
        tw(Dim, dur, { BackgroundTransparency = 1 })
        tw(Tint, dur, { BackgroundTransparency = 1 })
        if blur then tw(blur, dur, { Size = 0 }) end
        task.delay(dur + 0.2, Splash.destroy)
    end

    -- pengaman: kalau UI gagal dibangun, jangan biarkan layar tertahan
    task.delay(10, function()
        if Splash.alive and not Splash.started then
            Splash.destroy()
            ScreenGui.Enabled = true
        end
    end)

    task.wait() -- beri satu frame agar intro tampil sebelum UI utama dibangun
end

