    function renderPlayers()
        if currentCat ~= "TELEPORT" then return end
        table.clear(distLabels)
        for _, c in ipairs(TeleBox:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end
        local q = Search.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
        local list, dist = {}, {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Parent == Players
                and (q == "" or p.Name:lower():find(q, 1, true) or p.DisplayName:lower():find(q, 1, true)) then
                list[#list + 1] = p
                dist[p] = distTo(p)
            end
        end
        table.sort(list, function(a, b)
            if teleSort == "Nearest" then
                return (dist[a] or math.huge) < (dist[b] or math.huge)
            elseif teleSort == "Farthest" then
                return (dist[a] or -1) > (dist[b] or -1)
            end
            return a.DisplayName:lower() < b.DisplayName:lower()
        end)
        for i, p in ipairs(list) do playerRow(p, i) end
        if #list == 0 then
            make("TextLabel", {
                Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1,
                Text = (q == "") and "Tidak ada pemain lain di server ini" or "Pemain tidak ditemukan",
                TextColor3 = "@MUTED", TextSize = 12, Font = F.Medium, LayoutOrder = 1,
            }, TeleBox)
        end
        TeleCount.Text = ("%d players"):format(#list)
        registerFade(TeleBox, true)
    end

    -- jarak diperbarui langsung tanpa membangun ulang daftar
    task.spawn(function()
        while ScreenGui.Parent do
            task.wait(0.4)
            if currentCat == "TELEPORT" and shown then
                for plr, lbl in pairs(distLabels) do
                    if lbl.Parent then lbl.Text = subText(plr) end
                end
            end
        end
    end)

    local views = { UNIVERSAL = Cards, UTILITY = UtilCards, TELEPORT = TeleScroll }
    local function setCategory(name)
        local changed = currentCat ~= name
        currentCat = name
        for k, v in pairs(views) do
            if k == name then
                if changed and v.Visible == false then
                    v.Position = UDim2.new(0, 12, 0, 124)
                    v.Visible = true
                    tw(v, 0.45, { Position = UDim2.new(0, 12, 0, 114) }, Enum.EasingStyle.Quint)
                else
                    v.Visible = true
                end
            else
                v.Visible = false
            end
        end
        for i, n in ipairs(CATS) do
            if n == name then
                tw(CatPill, 0.45, { Position = UDim2.new((i - 1) / #CATS, 2, 0, 2) }, Enum.EasingStyle.Quint)
            end
        end
        Search.PlaceholderText = (name == "TELEPORT") and "Cari pemain" or "Spotlight Search"
        renderPlayers()
    end
    for i, name in ipairs(CATS) do
        local b = make("TextButton", {
            Size = UDim2.new(1 / #CATS, 0, 1, 0), Position = UDim2.new((i - 1) / #CATS, 0, 0, 0),
