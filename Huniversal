local logCount = 0
local function log(msg, kind)
    local color = ({ ok = C.ACCENT2, err = C.ERR, warn = C.WARN })[kind] or C.LOG
    logCount += 1
    local line = ("[%s] %s"):format(os.date("%H:%M:%S"), tostring(msg))
    for _, sf in ipairs(consoles) do
        make("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Text = line, TextColor3 = color,
            TextSize = 11, Font = Enum.Font.Code, TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = logCount,
        }, sf)
        task.defer(function()
            sf.CanvasPosition = Vector2.new(0, sf.AbsoluteCanvasSize.Y)
        end)
    end
end
local function clearConsoles()
    for _, sf in ipairs(consoles) do
        for _, c in ipairs(sf:GetChildren()) do
            if c:IsA("TextLabel") then c:Destroy() end
        end
    end
end

