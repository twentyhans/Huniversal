    function renderServers()
        for _, c in ipairs(SrvBox:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end
        local rawQ = (SrvSearch.Text:gsub("%s", ""))
        local q = rawQ:lower()
        local matches = {}
        for _, s in ipairs(srvData) do
            if q == "" or (s.id:lower():find(q, 1, true) ~= nil) or (tostring(s.playing) == q) then
                matches[#matches + 1] = s
            end
        end

        local totalPages = math.max(1, math.ceil(#matches / PAGE_SIZE))
        srvPage = math.clamp(srvPage, 1, totalPages)
        local first = (srvPage - 1) * PAGE_SIZE
        local n = 0
        for i = 1, PAGE_SIZE do
            local sv = matches[first + i]
            if sv then
                n += 1
                serverRow(sv, n)
            end
        end

        if #matches == 0 and rawQ:match(JOBID_PATTERN) then
            n += 1
            jobIdRow(n, rawQ)
        elseif #matches == 0 then
            n += 1
            messageRow(n, srvBusy and "Loading servers..." or "No servers found")
        end

        if #matches > 0 then
            n += 1
            pagerRow(n, totalPages)
        end

        SrvCount.Text = ("%d servers"):format(#matches)
        SrvStatus.Text = ("%d loaded"):format(#srvData) .. (srvNote ~= "" and ("  ·  " .. srvNote) or "")
        SrvRefresh.TextTransparency = srvBusy and 0.6 or 0
    end

    -- Fetch ------------------------------------------------------------------------------
    local function sortServers()
        table.sort(srvData, function(a, b)
            if srvSort == "most" then return (a.playing or 0) > (b.playing or 0) end
            return (a.playing or 0) < (b.playing or 0)
        end)
    end

    local HOSTS = { "games.roblox.com", "games.roproxy.com" }

    local function waitWithStatus(sec, msg)
        for i = math.ceil(sec), 1, -1 do
            if not ScreenGui.Parent then return end
            SrvStatus.Text = ("%s (%d dtk)"):format(msg, i)
            task.wait(1)
        end
    end

    -- Ambil satu halaman server. Bergantian antar host, dan menunggu bertahap bila terkena rate limit.
    local function requestPage(order, cursor, startIdx)
        local lastReason
        for attempt = 1, 5 do
            local waitFor = 0
            for h = 0, 1 do
                local host = HOSTS[((startIdx + h - 1) % 2) + 1]
                local url = ("https://%s/v1/games/%d/servers/Public?sortOrder=%s&excludeFullGames=false&limit=100")
                    :format(host, game.PlaceId, order)
                if cursor then url = url .. "&cursor=" .. HttpService:UrlEncode(cursor) end

                local body, reason, status, retry = httpGet(url)
                if body then
                    local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
                    if ok and type(data) == "table" and not data.errors then
                        return data
                    end
                    reason = (ok and type(data) == "table" and data.errors and data.errors[1]
                        and tostring(data.errors[1].message)) or "respon tidak valid (kemungkinan rate limit)"
                    waitFor = math.max(waitFor, 3 * attempt)
                elseif status == 429 then
                    waitFor = math.max(waitFor, retry or (4 * attempt))
                else
                    waitFor = math.max(waitFor, 2 * attempt)
                end
                lastReason = host .. ": " .. tostring(reason)
            end
            if attempt < 5 then
                waitWithStatus(math.min(waitFor, 15), "Rate limit, mencoba lagi")
            end
        end
        return nil, lastReason
    end

    local function addServers(arr)
        for _, s in ipairs(arr) do
            if type(s) == "table" and s.id and not srvIds[s.id] then
                srvIds[s.id] = true
                table.insert(srvData, s)
            end
        end
    end

    -- reset = true: mulai dari awal. reset = false: lanjut dari halaman terakhir.
    function loadPages(reset, pages, advance)
        if srvBusy then return end
        srvBusy = true
        lastFetch = os.clock()
        srvNote = "loading..."
        renderServers()
        task.spawn(function()
            local order = (srvSort == "most") and "Desc" or "Asc"
            local fresh = reset
            local loaded, lastErr = 0, nil
            local cursor = (not reset) and srvCursor or nil

            local okRun, runErr = pcall(function()
                for page = 1, pages do
                    local data, err = requestPage(order, cursor, page)
                    if not data then lastErr = tostring(err) break end

                    if fresh then
                        srvData, srvIds, srvDone, fresh = {}, {}, false, false
                    end
                    local arr = data.data or {}
                    addServers(arr)
                    loaded += #arr
                    cursor = data.nextPageCursor
                    srvCursor = cursor
                    if not cursor then srvDone = true break end

                    sortServers()
                    srvNote = ("loading... (%d/%d halaman)"):format(page, pages)
                    renderServers()
                    if page < pages then task.wait(1.5) end
                end
            end)
            if not okRun then lastErr = tostring(runErr) end
            srvBusy = false
            if loaded > 0 then srvLoadedOnce = true end
            if advance and loaded > 0 then srvPage += 1 end

            if game.JobId ~= "" and not srvIds[game.JobId] and (not fresh or #srvData == 0) then
                srvIds[game.JobId] = true
                table.insert(srvData, {
                    id = game.JobId, playing = #Players:GetPlayers(), maxPlayers = Players.MaxPlayers,
                })
            end
            sortServers()

            if lastErr then
                srvNote = ((loaded > 0) and "sebagian dimuat, tekan Load more untuk lanjut: " or "gagal: ") .. lastErr
                log("Server browser: " .. lastErr, (loaded > 0) and "warn" or "err")
            elseif srvDone then
                srvNote = "semua server dimuat"
                log("Loaded " .. #srvData .. " servers (semua)", "ok")
            else
                srvNote = ""
                log("Loaded " .. #srvData .. " servers", "ok")
            end
            renderServers()
        end)
    end

    function fetchServers(silent)
        if srvBusy then return end
        local remaining = FETCH_COOLDOWN - (os.clock() - lastFetch)
        if remaining > 0 and srvLoadedOnce then
            if not silent then
                SrvStatus.Text = ("Tunggu %d detik sebelum refresh lagi..."):format(math.ceil(remaining))
            end
            return
        end
        loadPages(true, PAGES_FIRST)
    end

    -- Event ----------------------------------------------------------------------------------
    local function changeSort(mode)
        if srvSort == mode then return end
        srvSort = mode
        styleSort()
        srvPage = 1
        sortServers()
        renderServers()
        fetchServers(true)
    end
