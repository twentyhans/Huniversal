    table.insert(extraCleanups, function() setAntiAfk(false) end)

    ----------------------------------------------------------------
    -- Fullbright + No Fog
    ----------------------------------------------------------------
    local light = { full = false, nofog = false, orig = nil, atm = {}, conn = nil, acc = 0 }
    local function lightSave()
        if light.orig then return end
        light.orig = {
            Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime,
            GlobalShadows = Lighting.GlobalShadows, Ambient = Lighting.Ambient,
            OutdoorAmbient = Lighting.OutdoorAmbient,
            FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart,
        }
        for _, a in ipairs(Lighting:GetChildren()) do
            if a:IsA("Atmosphere") then light.atm[a] = { a.Density, a.Haze } end
        end
    end
    local function lightApply()
        if light.full then
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.GlobalShadows = false
            Lighting.Ambient = Color3.fromRGB(178, 178, 178)
            Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
        end
        if light.nofog then
            Lighting.FogStart = 0
            Lighting.FogEnd = 1e6
            for a in pairs(light.atm) do
                if a.Parent then
                    a.Density = 0
                    a.Haze = 0
                end
            end
        end
    end
    local function lightRestore(which)
        local o = light.orig
        if not o then return end
        if which == "full" then
            Lighting.Brightness, Lighting.ClockTime = o.Brightness, o.ClockTime
            Lighting.GlobalShadows = o.GlobalShadows
            Lighting.Ambient, Lighting.OutdoorAmbient = o.Ambient, o.OutdoorAmbient
        else
            Lighting.FogStart, Lighting.FogEnd = o.FogStart, o.FogEnd
            for a, v in pairs(light.atm) do
                if a.Parent then a.Density, a.Haze = v[1], v[2] end
            end
        end
    end
    local function setLight(which, on)
        if on then lightSave() end
        light[which] = on
        if on then lightApply() else lightRestore(which) end
        local need = light.full or light.nofog
        if need and not light.conn then
            light.conn = RunService.Heartbeat:Connect(function(dt)
                light.acc += dt
                if light.acc < 0.2 then return end
                light.acc = 0
                lightApply()
            end)
        elseif not need then
            if light.conn then light.conn:Disconnect() light.conn = nil end
            light.orig, light.atm = nil, {}
        end
    end
    table.insert(extraCleanups, function()
        if light.full then setLight("full", false) end
        if light.nofog then setLight("nofog", false) end
    end)

    ----------------------------------------------------------------
    -- FPS Booster
    ----------------------------------------------------------------
    local EFFECTS = {
        BloomEffect = true, SunRaysEffect = true, DepthOfFieldEffect = true, BlurEffect = true,
        ParticleEmitter = true, Trail = true, Smoke = true, Fire = true, Sparkles = true, Beam = true,
    }
    local fps = { on = false, saved = {}, conn = nil, quality = nil, shadows = nil }
    local function fpsHandle(inst)
        if not EFFECTS[inst.ClassName] then return end
        if inst.Name == "HUniversalBlur" or inst.Name == "HUniversalSplashBlur" then return end
        pcall(function()
            if inst.Enabled then
                fps.saved[inst] = true
                inst.Enabled = false
            end
        end)
    end
    local function setFps(on)
        fps.on = on
        if fps.conn then fps.conn:Disconnect() fps.conn = nil end
        if on then
            pcall(function() fps.quality = settings().Rendering.QualityLevel end)
            pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
            fps.shadows = Lighting.GlobalShadows
            Lighting.GlobalShadows = false
            for _, d in ipairs(Lighting:GetChildren()) do fpsHandle(d) end
            task.spawn(function()
                local n = 0
                for _, d in ipairs(Workspace:GetDescendants()) do
                    if not fps.on then break end
                    fpsHandle(d)
                    n += 1
                    if n % 400 == 0 then task.wait() end
                end
            end)
            fps.conn = Workspace.DescendantAdded:Connect(fpsHandle)
        else
            for inst in pairs(fps.saved) do
                pcall(function() if inst.Parent then inst.Enabled = true end end)
            end
            fps.saved = {}
            if fps.quality then
                pcall(function() settings().Rendering.QualityLevel = fps.quality end)
            end
            if fps.shadows ~= nil then Lighting.GlobalShadows = fps.shadows end
        end
    end
    table.insert(extraCleanups, function() if fps.on then setFps(false) end end)

    ----------------------------------------------------------------
    -- Click Teleport (PC: Ctrl+klik atau klik biasa, HP: ketuk layar)
    ----------------------------------------------------------------
    local ctpMode = "Ctrl+Klik" -- "Ctrl+Klik" atau "Klik"
    local ctpConns = {}

    local function clickTeleport(ray)
        local root, hum = getRoot(), getHumanoid()
        if not root then
            log("Click Teleport: karakter belum siap", "warn")
            return
        end
        -- abaikan semua karakter pemain supaya sinar tidak tersangkut di badan orang
        local ignore = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then ignore[#ignore + 1] = p.Character end
        end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = ignore
        pcall(function() params.RespectCanCollide = true end) -- lewati tembok / part tak terlihat
        local hit = Workspace:Raycast(ray.Origin, ray.Direction * 5000, params)
        if not hit then
            log("Click Teleport: tidak ada permukaan di titik itu", "warn")
            return
        end
        local height = math.max((hum and hum.HipHeight or 2) + root.Size.Y / 2, 3) + 1
        local pos
        if hit.Normal.Y > 0.5 then
            pos = hit.Position + Vector3.new(0, height, 0)                  -- lantai / permukaan datar
        else
            pos = hit.Position + hit.Normal * 2.5 + Vector3.new(0, 1, 0)    -- dinding: geser keluar
        end
        root.CFrame = CFrame.new(pos) * root.CFrame.Rotation
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
        log(("Click Teleport -> %d, %d, %d"):format(
            math.floor(pos.X + 0.5), math.floor(pos.Y + 0.5), math.floor(pos.Z + 0.5)), "ok")
    end

    local function mouseRay()
        local cam = Workspace.CurrentCamera
        if not cam then return nil end
        local m = UserInputService:GetMouseLocation()
        return cam:ViewportPointToRay(m.X, m.Y)
    end

    local function setClickTp(on)
        for _, c in ipairs(ctpConns) do c:Disconnect() end
        table.clear(ctpConns)
        if not on then return end
        local downPos, downAt
        ctpConns[1] = UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe or input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            if ctpMode == "Ctrl+Klik" then
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
                    or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
                    local r = mouseRay()
                    if r then clickTeleport(r) end
                end
            else
                downPos, downAt = UserInputService:GetMouseLocation(), os.clock()
            end
        end)
        -- mode "Klik": hanya klik singkat tanpa geser (supaya tidak ikut saat memutar kamera)
        ctpConns[2] = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            if ctpMode ~= "Klik" or not downPos then return end
            local moved = (UserInputService:GetMouseLocation() - downPos).Magnitude
            local quick = os.clock() - downAt < 0.35
            downPos = nil
            if moved < 6 and quick then
                local r = mouseRay()
                if r then clickTeleport(r) end
            end
        end)
        -- HP: ketuk dunia game
        ctpConns[3] = UserInputService.TouchTapInWorld:Connect(function(pos, processed)
            if processed then return end
            local cam = Workspace.CurrentCamera
            if cam then clickTeleport(cam:ScreenPointToRay(pos.X, pos.Y)) end
        end)
    end
    table.insert(extraCleanups, function() setClickTp(false) end)

    ----------------------------------------------------------------
    -- ESP (nama, jarak, highlight, bar darah, warna tim, jarak maksimum)
    ----------------------------------------------------------------
    for _, c in ipairs(parentTarget:GetChildren()) do
        if c.Name == "HUniversalESP" then c:Destroy() end
    end
    local espFolder = Instance.new("Folder")
    espFolder.Name = "HUniversalESP"
    espFolder.Parent = parentTarget
    local esp = { box = true, health = true, team = true, maxDist = 2000 }
    local espItems, espOn, espToken = {}, false, 0

    local function espNew(head)
        local gui = make("BillboardGui", {
            Name = "ESP", AlwaysOnTop = true, Size = UDim2.fromOffset(160, 48),
            StudsOffset = Vector3.new(0, 2.8, 0), LightInfluence = 0, Adornee = head,
        }, espFolder)
        local lbl = make("TextLabel", {
            Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Text = "",
            TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.4,
            TextSize = 13, Font = F.Bold,
        }, gui)
        local barBg = make("Frame", {
            Size = UDim2.fromOffset(72, 5), AnchorPoint = Vector2.new(0.5, 0),
            Position = UDim2.new(0.5, 0, 0, 34), BackgroundColor3 = Color3.new(0, 0, 0),
            BackgroundTransparency = 0.4, BorderSizePixel = 0,
        }, gui)
        corner(barBg, PILL)
        local barFill = make("Frame", {
            Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(52, 199, 89),
            BorderSizePixel = 0,
        }, barBg)
        corner(barFill, PILL)
        return { gui = gui, lbl = lbl, bar = barBg, fill = barFill, hl = nil }
    end
    local function espDestroy(e)
        pcall(function() e.gui:Destroy() end)
        if e.hl then pcall(function() e.hl:Destroy() end) end
    end
    local function espClear()
        for p, e in pairs(espItems) do
            espDestroy(e)
            espItems[p] = nil
        end
    end
    local function espStep()
        local myRoot = getRoot()
        for plr, e in pairs(espItems) do
            if plr.Parent ~= Players then
                espDestroy(e)
                espItems[plr] = nil
            end
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local char = plr.Character
                local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
                local tRoot = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local d = (myRoot and tRoot) and (myRoot.Position - tRoot.Position).Magnitude or nil
                local e = espItems[plr]
                if head and (not d or d <= esp.maxDist) then
                    if not e then
                        e = espNew(head)
                        espItems[plr] = e
                    elseif e.gui.Adornee ~= head then
                        e.gui.Adornee = head
                    end
                    local color = (esp.team and plr.Team) and plr.TeamColor.Color or Color3.new(1, 1, 1)
                    e.lbl.TextColor3 = color
                    e.lbl.Text = plr.DisplayName .. "\n" .. (d and (math.floor(d + 0.5) .. " studs") or "-")

                    -- bar darah
                    e.bar.Visible = esp.health and hum ~= nil
                    if hum and hum.MaxHealth > 0 then
                        local r = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        e.fill.Size = UDim2.new(r, 0, 1, 0)
                        e.fill.BackgroundColor3 = Color3.fromRGB(255, 69, 58):Lerp(Color3.fromRGB(52, 199, 89), r)
                    end

                    -- highlight badan
                    if esp.box and char then
                        if not e.hl or not e.hl.Parent then
                            local hl = Instance.new("Highlight")
                            hl.FillTransparency = 0.75
                            hl.OutlineTransparency = 0.1
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Parent = espFolder
                            e.hl = hl
                        end
                        if e.hl.Adornee ~= char then e.hl.Adornee = char end
                        e.hl.FillColor, e.hl.OutlineColor = color, color
                    elseif e.hl then
                        pcall(function() e.hl:Destroy() end)
                        e.hl = nil
                    end
                elseif e then
                    espDestroy(e)
                    espItems[plr] = nil
                end
            end
        end
    end
    local function setEsp(on)
        espOn = on
        espToken += 1
        local mine = espToken
        if on then
            task.spawn(function()
                while espOn and mine == espToken and ScreenGui.Parent do
                    pcall(espStep)
                    task.wait(0.2)
                end
            end)
        else
            espClear()
        end
    end
    table.insert(extraCleanups, function()
        setEsp(false)
        pcall(function() espFolder:Destroy() end)
    end)

    ----------------------------------------------------------------
    -- Waypoint (tersimpan per game)
    ----------------------------------------------------------------
    local WP_FILE = "HUniversal_Waypoints.json"
    local wpAll = readJson(WP_FILE) or {}
    local placeKey = tostring(game.PlaceId)
    if type(wpAll[placeKey]) ~= "table" then wpAll[placeKey] = {} end
