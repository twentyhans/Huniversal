    local PING_GREEN, PING_YELLOW, PING_RED =
        Color3.fromRGB(48, 209, 88), Color3.fromRGB(255, 214, 10), Color3.fromRGB(255, 69, 58)
    local function pingColor(ms)
        if ms <= 50 then return PING_GREEN end
        if ms <= 120 then return PING_GREEN:Lerp(PING_YELLOW, (ms - 50) / 70) end
        if ms <= 250 then return PING_YELLOW:Lerp(PING_RED, (ms - 120) / 130) end
        return PING_RED
    end
    local function pingHex(ms)
        local c = pingColor(ms)
        return ("#%02X%02X%02X"):format(
            math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
    end
    local LOAD_GREEN, LOAD_ORANGE, LOAD_RED =
        Color3.fromRGB(52, 199, 89), Color3.fromRGB(255, 159, 10), Color3.fromRGB(255, 69, 58)
    local function loadColor(r)
        if r < 0.6 then return LOAD_GREEN end
        if r < 0.9 then return LOAD_ORANGE end
        return LOAD_RED
    end

