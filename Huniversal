    -- HTTP -----------------------------------------------------------------------
    -- Mengembalikan: body, atau nil + alasan + status code + retry-after (detik)
    local function httpGet(url)
        local reason, status, retry

        local getters = {
            function() return syn and syn.request end,
            function() return http_request end,
            function() return request end,
            function() return fluxus and fluxus.request end,
            function() return http and http.request end,
        }
        for _, getter in ipairs(getters) do
            local okG, fn = pcall(getter)
            if okG and type(fn) == "function" then
                local okR, r = pcall(fn, { Url = url, Method = "GET" })
                if okR and type(r) == "table" then
                    status = r.StatusCode
                    if type(r.Body) == "string" and #r.Body > 0 and (status == nil or status == 200) then
                        return r.Body
                    end
                    if status == 429 and type(r.Headers) == "table" then
                        retry = tonumber(r.Headers["retry-after"] or r.Headers["Retry-After"])
                    end
                    reason = "HTTP " .. tostring(status or "?")
                    break
                elseif not okR then
                    reason = tostring(r)
                end
            end
        end

        local ok, res = pcall(function() return game:HttpGet(url) end)
        if ok and type(res) == "string" and #res > 0 then return res end
        if not ok then
            reason = reason or tostring(res)
            if tostring(res):find("429") then status = 429 end
        end
        return nil, reason or "respon kosong", status, retry
    end

