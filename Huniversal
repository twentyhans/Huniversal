    local specTarget, specConn
    local function stopSpectate(reason)
        if specConn then
            specConn:Disconnect()
            specConn = nil
        end
        if not specTarget then return end
        specTarget = nil
        local cam, h = Workspace.CurrentCamera, getHumanoid()
        if cam and h then cam.CameraSubject = h end
        if reason then log(reason, "info") end
        renderPlayers()
    end

    local function startSpectate(plr)
        if specTarget == plr then
            stopSpectate("Spectate dimatikan")
            return
        end
        if specConn then
            specConn:Disconnect()
            specConn = nil
        end
        specTarget = plr
        log(("Spectate %s (@%s)"):format(plr.DisplayName, plr.Name), "ok")
        specConn = track(RunService.RenderStepped:Connect(function()
            if plr.Parent ~= Players then
                stopSpectate("Spectate berhenti: pemain keluar dari server")
                return
            end
            local cam = Workspace.CurrentCamera
            local h = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
            if cam and h and cam.CameraSubject ~= h then cam.CameraSubject = h end
        end))
        renderPlayers()
    end

