-- Helper warna
local function toHex(t) return ("#%02X%02X%02X"):format(t[1], t[2], t[3]) end
local function colorToHex(c)
    return ("#%02X%02X%02X"):format(
        math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end
local function parseHex(str)
    local s = tostring(str):gsub("%s", "")
    s = s:gsub("^#", "")
    if #s == 3 then s = s:gsub(".", "%0%0") end
    if not s:match("^%x%x%x%x%x%x$") then return nil end
    return { tonumber(s:sub(1, 2), 16), tonumber(s:sub(3, 4), 16), tonumber(s:sub(5, 6), 16) }
end

