    -- Follow: terus menempel di belakang pemain sampai dimatikan.
    -- Mode Teleport = menempel langsung; mode Tween = meluncur dulu dengan kecepatan Tween Speed,
    -- lalu menempel begitu sudah dekat.
    local FOLLOW_DIST = 3
    local stopOrbit = function() end -- diisi di bawah (Orbit)
    local followConn, followTarget
    local function stopFollow(reason)
        if followConn then
            followConn:Disconnect()
            followConn, followTarget = nil, nil
            if reason then log(reason, "info") end
            renderPlayers() -- perbarui label tombol Follow
        end
    end

    local function startFollow(plr)
        if followTarget == plr then
            stopFollow("Follow dimatikan")
            return
        end
        cancelTween()
        stopOrbit()
        local hadFollow = followConn ~= nil
        if hadFollow then
            followConn:Disconnect()
            followConn = nil
        end
        if not getRoot() then
            log("Karaktermu belum siap", "warn")
            return
        end
        followTarget = plr
        log(("Follow %s (@%s)"):format(plr.DisplayName, plr.Name), "ok")
        followConn = track(RunService.Heartbeat:Connect(function(dt)
            local root = getRoot()
            local tChar = plr.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
            if plr.Parent ~= Players then
                stopFollow("Follow berhenti: pemain keluar dari server")
                return
            end
            if not root or not tRoot then return end -- tunggu respawn, lanjut otomatis
            local goal = (tRoot.CFrame * CFrame.new(0, 1, FOLLOW_DIST)).Position
            local delta = goal - root.Position
            local dist = delta.Magnitude
            if teleMode == "Tween" and dist > 4 then
                local step = math.min(dist, tweenSpeed * dt)
                root.CFrame = CFrame.new(root.Position + delta.Unit * step) * root.CFrame.Rotation
            else
                root.CFrame = CFrame.new(goal) * tRoot.CFrame.Rotation
            end
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)
        end))
        renderPlayers()
    end

    local function teleportTo(plr)
        local myRoot = getRoot()
        local tChar = plr.Character
        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then
            log("Karaktermu belum siap", "warn")
            return false
        end
        if not tRoot then
            log(plr.DisplayName .. " belum punya karakter", "warn")
            return false
        end
        myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 1, 3) -- sedikit di belakang target
        pcall(function() myRoot.AssemblyLinearVelocity = Vector3.zero end)
        log(("Teleport ke %s (@%s)"):format(plr.DisplayName, plr.Name), "ok")
        return true
    end

    -- Meluncur ke pemain dengan kecepatan tetap (mengikuti kalau targetnya bergerak).
    -- Ketuk lagi pemain yang sama untuk membatalkan. Aktifkan Noclip kalau terhalang dinding.
    local function tweenToPlayer(plr)
        if tweenTarget == plr then
            cancelTween("Tween dibatalkan")
            return
        end
        cancelTween()
        if not getRoot() then
            log("Karaktermu belum siap", "warn")
            return
        end
        tweenTarget = plr
        local started = os.clock()
        log(("Tween ke %s (@%s) - %d studs/s"):format(plr.DisplayName, plr.Name, tweenSpeed), "info")
        tweenConn = track(RunService.Heartbeat:Connect(function(dt)
            local root = getRoot()
            local tChar = plr.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
            if not root or not tRoot or plr.Parent ~= Players then
                cancelTween("Tween berhenti: karakter atau target tidak tersedia")
                return
            end
            if os.clock() - started > 60 then
                cancelTween("Tween berhenti: melebihi 60 detik")
                return
            end
            local goal = (tRoot.CFrame * CFrame.new(0, 1, 3)).Position
            local delta = goal - root.Position
            local dist = delta.Magnitude
            if dist <= 1.5 then
                cancelTween()
                log(("Tiba di dekat %s"):format(plr.DisplayName), "ok")
                return
            end
            local step = math.min(dist, tweenSpeed * dt)
            root.CFrame = CFrame.new(root.Position + delta.Unit * step) * root.CFrame.Rotation
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)
        end))
    end

    ----------------------------------------------------------------
    -- ORBIT: berputar mengelilingi pemain (tidak menyentuh), ketuk lagi untuk berhenti
    ----------------------------------------------------------------
    local ORBIT_RADIUS, ORBIT_SPEED = 9, 1.6
    local orbitConn, orbitTarget
    stopOrbit = function(reason)
        if orbitConn then
            orbitConn:Disconnect()
            orbitConn, orbitTarget = nil, nil
            if reason then log(reason, "info") end
            renderPlayers()
        end
    end

    local function startOrbit(plr)
        if orbitTarget == plr then
            stopOrbit("Orbit dimatikan")
            return
        end
        cancelTween()
        stopFollow()
        stopOrbit()
        if not getRoot() then
            log("Karaktermu belum siap", "warn")
            return
        end
        orbitTarget = plr
        local ang = 0
        log(("Orbit %s (@%s)"):format(plr.DisplayName, plr.Name), "ok")
        orbitConn = track(RunService.Heartbeat:Connect(function(dt)
            if plr.Parent ~= Players then
                stopOrbit("Orbit berhenti: pemain keluar dari server")
                return
            end
            local root = getRoot()
            local tRoot = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if not root or not tRoot then return end
            ang += ORBIT_SPEED * dt
            local c = tRoot.Position
            local pos = c + Vector3.new(math.cos(ang) * ORBIT_RADIUS, 2, math.sin(ang) * ORBIT_RADIUS)
            root.CFrame = CFrame.lookAt(pos, Vector3.new(c.X, pos.Y, c.Z))
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)
        end))
        renderPlayers()
    end

    ----------------------------------------------------------------
    -- SPECTATE: kamera mengikuti pemain, ketuk lagi untuk kembali
