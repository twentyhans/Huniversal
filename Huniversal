local COLOR_PROPS = {
    BackgroundColor3 = true, TextColor3 = true, ImageColor3 = true, Color = true,
    ScrollBarImageColor3 = true, PlaceholderColor3 = true,
}
local themed, themeHooks = {}, {}

local function make(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do
        if COLOR_PROPS[k] and type(v) == "string" and v:sub(1, 1) == "@" then
            local key = v:sub(2)
            o[k] = C[key]
            themed[#themed + 1] = { o, k, key }
        else
            o[k] = v
        end
    end
    if parent then o.Parent = parent end
    return o
end

local function merge(base, extra)
    for k, v in pairs(extra or {}) do base[k] = v end
    return base
end

