local lastFetch, srvHasReal = 0, false
local FETCH_COOLDOWN = 4

local function sortServers()
    table.sort(srvData, function(a, b)
        if srvSort == "most" then return (a.playing or 0) > (b.playing or 0) end
        return (a.playing or 0) < (b.playing or 0)
    end)
end

-- Ambil JSON dengan 1x percobaan ulang (menangani rate limit / respon kosong)
local function requestJson(url)
    local lastReason
    for attempt = 1, 2 do
        local body, err = httpGet(url)
        if body then
            local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
            if ok and type(data) == "table" then
                if data.errors then
                    lastReason = tostring(data.errors[1] and data.errors[1].message or "error")
                else
                    return data
                end
            else
                lastReason = "respon tidak valid (kemungkinan terkena rate limit)"
            end
        else
            lastReason = tostring(err)
        end
        if attempt == 1 then task.wait(1.5) end
    end
    return nil, lastReason
end

local function fetchServers(silent)
    if srvBusy then return end
    local remaining = FETCH_COOLDOWN - (os.clock() - lastFetch)
    if remaining > 0 and srvHasReal then
        if not silent then
            SrvStatus.Text = ("Tunggu %d detik sebelum refresh lagi..."):format(math.ceil(remaining))
        end
        return
    end
    srvBusy = true
    lastFetch = os.clock()
    SrvStatus.Text = "Loading servers..."
    task.spawn(function()
        local list, lastErr = {}, nil

        local okRun, runErr = pcall(function()
            local order = (srvSort == "most") and "Desc" or "Asc"
            local hosts = { "games.roblox.com", "games.roproxy.com" }

            for _, host in ipairs(hosts) do
                list, lastErr = {}, nil
                local cursor = nil
                for _ = 1, 3 do
                    local url = ("https://%s/v1/games/%d/servers/Public?sortOrder=%s&excludeFullGames=false&limit=100")
                        :format(host, game.PlaceId, order)
                    if cursor then url = url .. "&cursor=" .. HttpService:UrlEncode(cursor) end

                    local data, err = requestJson(url)
                    if not data then lastErr = host .. ": " .. tostring(err) break end

                    for _, s in ipairs(data.data or {}) do table.insert(list, s) end
                    cursor = data.nextPageCursor
                    if not cursor then break end
                    task.wait(0.6)
                end
                if #list > 0 then lastErr = nil break end
            end
        end)
        if not okRun then lastErr = tostring(runErr) end
        srvBusy = false

        -- Gagal: pertahankan daftar sebelumnya, jangan dikosongkan
        if #list == 0 and srvHasReal then
            SrvStatus.Text = ("%d loaded (data lama) - gagal refresh: %s"):format(#srvData, tostring(lastErr))
            log("Server browser: " .. tostring(lastErr), "warn")
            return
        end

        if #list > 0 then srvHasReal = true end

        if game.JobId ~= "" then
            local found = false
            for _, s in ipairs(list) do
                if s.id == game.JobId then found = true break end
            end
            if not found then
                table.insert(list, {
                    id = game.JobId,
                    playing = #Players:GetPlayers(),
                    maxPlayers = Players.MaxPlayers,
                })
            end
        end

        srvData = list
        sortServers()
        renderServers()

        if lastErr then
            SrvStatus.Text = "Gagal memuat server: " .. lastErr
            log("Server browser: " .. lastErr, "err")
        else
            log("Loaded " .. #list .. " servers", "ok")
        end
    end)
end

