track(UserInputService.InputBegan:Connect(function(input, gpe)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if capturingId then
        local id = capturingId
        capturingId = nil
        local kc = input.KeyCode
        if kc == Enum.KeyCode.Escape then
            -- batal
        elseif kc == Enum.KeyCode.Backspace or kc == Enum.KeyCode.Delete then
            CONFIG.Keybinds[id] = ""
            onConfigChanged()
            log("Keybind " .. id .. " dihapus")
        elseif kc.Name == getUiKeyName() then
            log("Tombol " .. kc.Name .. " dipakai untuk toggle UI, pilih tombol lain", "warn")
        else
            local usedBy
            for other, name in pairs(CONFIG.Keybinds) do
                if other ~= id and name == kc.Name then usedBy = other end
            end
            if usedBy then
                log("Tombol " .. kc.Name .. " sudah dipakai oleh " .. usedBy, "warn")
            else
                CONFIG.Keybinds[id] = kc.Name
                onConfigChanged()
                log("Keybind " .. id .. " = " .. kc.Name, "ok")
            end
        end
        refreshBind(id)
        State.lastCapture = os.clock()
        return
    end

    if gpe or State.capturing or (os.clock() - State.lastCapture) < 0.2 then return end
    local pressed = input.KeyCode.Name
    for id, key in pairs(CONFIG.Keybinds) do
        local f = featureSetters[id]
        if f and key ~= "" and key == pressed then
            f.set(not f.get())
            return
        end
    end
end))

