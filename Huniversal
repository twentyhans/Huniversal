        end
    end
    local function glideTo(goal, label)
        stopGlide()
        if not getRoot() then
            log("Karaktermu belum siap", "warn")
            return
        end
        local started = os.clock()
        log(("Tween ke %s - %d studs/s"):format(label, glideSpeed), "info")
        glideConn = RunService.Heartbeat:Connect(function(dt)
            local root = getRoot()
            if not root then
                stopGlide("Tween berhenti: karakter tidak tersedia")
                return
            end
            local delta = goal - root.Position
            local dist = delta.Magnitude
            if dist <= 1.5 then
                stopGlide()
                log("Tiba di " .. label, "ok")
                return
            end
            if os.clock() - started > 90 then
                stopGlide("Tween berhenti: melebihi 90 detik")
                return
            end
            local step = math.min(dist, glideSpeed * dt)
            root.CFrame = CFrame.new(root.Position + delta.Unit * step) * root.CFrame.Rotation
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)
        end)
    end
