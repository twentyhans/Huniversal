                    b:Destroy()
                    if blurEffect == b then blurEffect = nil end
                end
            end)
        end
    end)
end

-- Animasi buka/tutup: scale + fade seluruh isi UI dalam satu kurva easing
local fadeList = {}
local animValue = Instance.new("NumberValue")
local animTween

local function snapshot()
    fadeList = { { Main, "BackgroundTransparency", Main.BackgroundTransparency } }
    for _, d in ipairs(Main:GetDescendants()) do
        if d:IsA("GuiObject") then
            table.insert(fadeList, { d, "BackgroundTransparency", d.BackgroundTransparency })
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                table.insert(fadeList, { d, "TextTransparency", d.TextTransparency })
            end
            if d:IsA("ImageLabel") then
                table.insert(fadeList, { d, "ImageTransparency", d.ImageTransparency })
            end
            if d:IsA("ScrollingFrame") then
                table.insert(fadeList, { d, "ScrollBarImageTransparency", d.ScrollBarImageTransparency })
            end
        elseif d:IsA("UIStroke") then
            table.insert(fadeList, { d, "Transparency", d.Transparency })
        end
    end
end

local scaleFrom = 0.9
local function applyProgress(v)
    local a = math.clamp(v * 1.5, 0, 1)
    MainScale.Scale = scaleFrom + (1 - scaleFrom) * v
    for _, e in ipairs(fadeList) do
        e[1][e[2]] = 1 - (1 - e[3]) * a
    end
end
animValue.Changed:Connect(applyProgress)

local function transition(target, dur, style, done)
    if animTween then animTween:Cancel() end
    animTween = TweenService:Create(animValue, TweenInfo.new(dur, style, Enum.EasingDirection.Out), { Value = target })
    animTween.Completed:Connect(function(state)
        if state == Enum.PlaybackState.Completed and done then done() end
    end)
    animTween:Play()
end

local visToken = 0
local function setVisible(v, done)
    shown = v
    visToken += 1
    local mine = visToken
    if v then
        if #fadeList == 0 then snapshot() end
        Main.Visible = true
        animValue.Value = 0
        transition(1, 0.6, Enum.EasingStyle.Exponential)
    else
        if animValue.Value > 0.99 then snapshot() end
        transition(0, 0.35, Enum.EasingStyle.Quint, function()
            if mine == visToken then
                Main.Visible = false
                if done then done() end
            end
        end)
    end
    applyBlur()
end

