    }, Gui)
    local IconScale = make("UIScale", { Scale = 0.4 }, IconG)
    local Icon = make("Frame", {
        Size = UDim2.fromOffset(92, 92), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, IconG)
    corner(Icon, UDim.new(0, 26))
    make("UIGradient", {
        Rotation = 70,
