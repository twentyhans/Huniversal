    corner(Track, PILL)
    local Fill = make("Frame", {
        Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, Track)
    corner(Fill, PILL)
    make("UIGradient", { Color = ColorSequence.new(C.ACCENT, C.ACCENT2:Lerp(WHITE, 0.45)) }, Fill)
