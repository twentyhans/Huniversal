    -- Ikon aplikasi (squircle kaca dengan huruf H chrome) ------------------------------------------
    local IconG = make("CanvasGroup", {
        Size = UDim2.fromOffset(130, 130), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, ICON_Y), BackgroundTransparency = 1,
