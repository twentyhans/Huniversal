    make("UITextSizeConstraint", { MaxTextSize = 58 }, hShadow)
    local hFace = make("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "H",
        TextColor3 = WHITE, TextScaled = true, Font = Enum.Font.Arcade,
    }, Icon)
    make("UITextSizeConstraint", { MaxTextSize = 58 }, hFace)
    make("UIGradient", { Rotation = 90, Color = CHROME }, hFace)

    -- Logo teks chrome blok 3D -----------------------------------------------------------------------
    local LogoG = make("CanvasGroup", {
        Size = UDim2.fromOffset(LOGO_W + 60, LOGO_H + 60), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, LOGO_Y + 16), BackgroundTransparency = 1,
        BorderSizePixel = 0, GroupTransparency = 1,
    }, Gui)
    local LogoScale = make("UIScale", {}, LogoG)

    local sheenGrad
    local function buildLogo(parent, chrome)
        local f = make("Frame", {
            Size = UDim2.fromOffset(LOGO_W, LOGO_H), BackgroundTransparency = 1, BorderSizePixel = 0,
        }, parent)
        local function layer(offset, color, transparency)
            local l = make("TextLabel", {
                Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(offset, offset),
                BackgroundTransparency = 1, Text = "HUniversal", TextColor3 = color,
                TextScaled = true, Font = Enum.Font.Arcade, TextTransparency = transparency or 0,
            }, f)
            make("UITextSizeConstraint", { MaxTextSize = 64 }, l)
            return l
        end
        local DEPTH = 7
        for i = DEPTH, 1, -1 do
            local t = (i - 1) / (DEPTH - 1)
            if chrome then
                layer(i, Color3.fromRGB(96, 106, 126):Lerp(Color3.fromRGB(26, 30, 40), t))
            else
                layer(i, Color3.fromRGB(34, 38, 48), 0.2)
            end
        end
        local face = layer(0, chrome and WHITE or Color3.fromRGB(66, 72, 86), chrome and 0 or 0.1)
        if chrome then
            make("UIGradient", { Rotation = 90, Color = CHROME }, face)
            make("UIStroke", {
                Color = Color3.fromRGB(22, 26, 36), Thickness = 2,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
            }, face)
            -- lapisan kilau: pita putih yang meluncur melintasi huruf
            local sheen = layer(0, WHITE, 0)
            sheenGrad = make("UIGradient", {
                Rotation = 0, Offset = Vector2.new(-1, 0),
                Transparency = seq({ { 0, 1 }, { 0.38, 1 }, { 0.5, 0 }, { 0.62, 1 }, { 1, 1 } }),
            }, sheen)
        end
        return f
    end

    local Holder = make("Frame", {
        Size = UDim2.fromOffset(LOGO_W, LOGO_H), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0,
    }, LogoG)
    buildLogo(Holder, false)
    local Reveal = make("Frame", {
        Size = UDim2.new(0, 0, 1, 0), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true,
    }, Holder)
    local chromeLogo = buildLogo(Reveal, true)
    chromeLogo.AnchorPoint = Vector2.new(1, 0)
    chromeLogo.Position = UDim2.new(1, 0, 0, 0)
    local Edge = make("Frame", {
        Size = UDim2.new(0, 28, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, Reveal)
    make("UIGradient", { Transparency = seq({ { 0, 0.3 }, { 1, 1 } }) }, Edge)

    -- Progress bar + status ---------------------------------------------------------------------------------
    local BarG = make("CanvasGroup", {
        Size = UDim2.fromOffset(320, 48), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, BAR_Y + 14), BackgroundTransparency = 1,
        BorderSizePixel = 0, GroupTransparency = 1,
    }, Gui)
    local Track = make("Frame", {
        Size = UDim2.new(1, -20, 0, 6), Position = UDim2.fromOffset(10, 6),
        BackgroundColor3 = WHITE, BackgroundTransparency = 0.82, BorderSizePixel = 0,
    }, BarG)
    corner(Track, PILL)
    local Fill = make("Frame", {
        Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, Track)
    corner(Fill, PILL)
    make("UIGradient", { Color = ColorSequence.new(C.ACCENT, C.ACCENT2:Lerp(WHITE, 0.45)) }, Fill)
    local Status = make("TextLabel", {
        Size = UDim2.new(0.7, 0, 0, 16), Position = UDim2.fromOffset(10, 20), BackgroundTransparency = 1,
        Text = "Initializing", TextColor3 = C.MUTED, TextSize = 11, Font = F.Medium,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, BarG)
    local Pct = make("TextLabel", {
        Size = UDim2.new(0.3, 0, 0, 16), Position = UDim2.new(0.7, -10, 0, 20), BackgroundTransparency = 1,
        Text = "0%", TextColor3 = C.TEXT, TextSize = 11, Font = F.Bold,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, BarG)

    -- Loop animasi (glow berdenyut, orbit, bokeh, progress) ---------------------------------------------------
    local t0 = os.clock()
    local orbitA, orbitTarget = 0, 1
    local prog = { on = false, start = 0, dur = 1 }
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        if not Splash.alive then
            conn:Disconnect()
            return
        end
        local now = os.clock() - t0
        orbitA += (orbitTarget - orbitA) * math.min(1, dt * 3)
        GlowScale.Scale = 1 + 0.05 * math.sin(now * 2.2)

        for i, d in ipairs(orbit) do
            local ang = now * 1.7 + (i - 1) * (math.pi * 2 / #orbit)
            local r = 74 + 4 * math.sin(now * 2 + i)
            d.Position = UDim2.new(0.5, math.cos(ang) * r, 0.5, ICON_Y + math.sin(ang) * r * 0.92)
            d.BackgroundTransparency = 1 - 0.7 * orbitA * (0.55 + 0.45 * math.sin(ang + now))
        end

        local H = math.max(Gui.AbsoluteSize.Y, 400)
        for _, b in ipairs(bokeh) do
            b.y -= b.speed * dt / H
            if b.y < -0.03 then
                b.y = 1.03
                b.x = rng:NextNumber()
            end
            b.f.Position = UDim2.new(b.x, 0, b.y, 0)
            b.f.BackgroundTransparency = 1 - (1 - b.base) * orbitA
        end

        if prog.on then
            local u = math.clamp((os.clock() - prog.start) / prog.dur, 0, 1)
            local p = (1 - math.cos(math.pi * u)) / 2 -- sama dengan Sine InOut
            Fill.Size = UDim2.new(p, 0, 1, 0)
            Pct.Text = ("%d%%"):format(math.floor(p * 100 + 0.5))
            Status.Text = (p < 0.15 and "Initializing") or (p < 0.4 and "Loading interface")
                or (p < 0.7 and "Preparing modules") or (p < 0.97 and "Connecting") or "Ready"
        end
    end)

