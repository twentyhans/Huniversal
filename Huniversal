-- Intro ala aplikasi: ikon + logo chrome terisi kanan->kiri, kilau, lalu zoom ke jendela
local INTRO_TIME = 3 -- durasi pengisian logo / progress (detik)
local function playIntro()
    Splash.started = true
    shown = true
    visToken += 1
    scaleFrom = 0.4
    snapshot()
    animValue.Value = 0
    applyProgress(0)
    Main.Visible = false
    ScreenGui.Enabled = true
    Splash.reveal(INTRO_TIME)

    task.spawn(function()
        task.wait(INTRO_TIME)
        Splash.sheen(0.7)
        task.wait(0.6)
        Splash.ripple()
        -- anchor di tengah agar jendela tumbuh dari titik tengah layar
        local origPos = Main.Position
        Main.AnchorPoint = Vector2.new(0.5, 0.5)
        Main.Position = UDim2.new(origPos.X.Scale, origPos.X.Offset + WIN_W / 2,
            origPos.Y.Scale, origPos.Y.Offset + WIN_H / 2)
        Main.Visible = true
        Splash.dissolve(1.0)
        transition(1, 1.0, Enum.EasingStyle.Exponential, function()
            Main.AnchorPoint = Vector2.new(0, 0)
            Main.Position = origPos
            scaleFrom = 0.9
            Splash.introActive = false
        end)
        applyBlur()
    end)
end
