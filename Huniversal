local MIN_W, MIN_H, MAX_W, MAX_H = 460, 300, 1000, 700
local Grip = make("TextButton", {
    Name = "ResizeGrip", Size = UDim2.fromOffset(TOUCH_UI and 36 or 26, TOUCH_UI and 36 or 26),
    AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -2, 1, -2),
