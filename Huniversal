local pages, tabs = {}, {}
local currentTab
local function selectTab(name)
    currentTab = name
    for n, p in pairs(pages) do p.Visible = (n == name) end
    for n, t in pairs(tabs) do
        local active = (n == name)
        tw(t.btn, 0.25, { BackgroundTransparency = active and 0.3 or 1 })
        tw(t.label, 0.25, { TextColor3 = active and C.TEXT or C.MUTED })
        tw(t.stroke, 0.25, { Transparency = active and 0.6 or 1 })
    end
end
table.insert(themeHooks, function() if currentTab then selectTab(currentTab) end end)

local function addTab(name, order, glyph, iconColor)
    local btn = make("TextButton", {
        Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = "@ACCENT", BackgroundTransparency = 1,
        BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = order,
