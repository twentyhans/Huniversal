-- Animasi buka/tutup: scale + fade seluruh isi UI dalam satu kurva easing
local fadeList = {}
local animValue = Instance.new("NumberValue")
local animTween

local function snapshot()
    fadeList = { { Main, "BackgroundTransparency", Main.BackgroundTransparency } }
    for _, d in ipairs(Main:GetDescendants()) do
        if d:IsA("GuiObject") then
            table.insert(fadeList, { d, "BackgroundTransparency", d.BackgroundTransparency })
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                table.insert(fadeList, { d, "TextTransparency", d.TextTransparency })
            end
            if d:IsA("ImageLabel") then
                table.insert(fadeList, { d, "ImageTransparency", d.ImageTransparency })
            end
            if d:IsA("ScrollingFrame") then
                table.insert(fadeList, { d, "ScrollBarImageTransparency", d.ScrollBarImageTransparency })
            end
        elseif d:IsA("UIStroke") then
            table.insert(fadeList, { d, "Transparency", d.Transparency })
        end
    end
end

-- Daftarkan elemen yang dibuat belakangan (baris pemain / server / log) ke animasi fade
local function registerFade(root, skipRoot)
    if #fadeList == 0 or not root then return end -- sebelum snapshot pertama: abaikan
    local a = math.clamp(animValue.Value * 1.5, 0, 1)
    local function add(inst, prop)
        local orig = inst[prop]
        fadeList[#fadeList + 1] = { inst, prop, orig }
        if a < 1 then inst[prop] = 1 - (1 - orig) * a end
    end
    local function visit(d)
        if d:IsA("GuiObject") then
            add(d, "BackgroundTransparency")
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then add(d, "TextTransparency") end
            if d:IsA("ImageLabel") then add(d, "ImageTransparency") end
            if d:IsA("ScrollingFrame") then add(d, "ScrollBarImageTransparency") end
        elseif d:IsA("UIStroke") then
            add(d, "Transparency")
        end
    end
    if not skipRoot then visit(root) end
    for _, d in ipairs(root:GetDescendants()) do visit(d) end
    if #fadeList > 4000 then -- buang entri objek yang sudah dihapus
        local alive = {}
        for _, e in ipairs(fadeList) do
            if e[1].Parent then alive[#alive + 1] = e end
        end
        fadeList = alive
    end
end

-- Skala agar jendela muat di layar kecil (HP): maksimal 1, minimal 0.4
local function fitScale()
    local cam = Workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
    local s = math.min((vp.X - 24) / WIN_W, (vp.Y - 24) / WIN_H, 1)
    return math.max(s, 0.4)
end

local scaleFrom = 0.9
local function applyProgress(v)
    local a = math.clamp(v * 1.5, 0, 1)
    MainScale.Scale = fitScale() * (scaleFrom + (1 - scaleFrom) * v)
    for _, e in ipairs(fadeList) do
        e[1][e[2]] = 1 - (1 - e[3]) * a
    end
end
animValue.Changed:Connect(applyProgress)
pcall(function()
    local cam = Workspace.CurrentCamera
    if cam then
        track(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            if animValue.Value > 0.99 then MainScale.Scale = fitScale() end
        end))
    end
end)

local function transition(target, dur, style, done)
    if animTween then animTween:Cancel() end
    animTween = TweenService:Create(animValue, TweenInfo.new(dur, style, Enum.EasingDirection.Out), { Value = target })
    animTween.Completed:Connect(function(state)
        if state == Enum.PlaybackState.Completed and done then done() end
    end)
    animTween:Play()
end

local visToken = 0
local function setVisible(v, done)
    shown = v
    visToken += 1
    local mine = visToken
    if v then
        if #fadeList == 0 then snapshot() end
        Main.Visible = true
        animValue.Value = 0
        transition(1, 0.75, Enum.EasingStyle.Quint)
    else
        if animValue.Value > 0.99 then snapshot() end
        transition(0, 0.4, Enum.EasingStyle.Quart, function()
            if mine == visToken then
                Main.Visible = false
                if done then done() end
            end
        end)
    end
    applyBlur()
end

