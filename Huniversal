-- Mengembalikan: body (string) atau nil + alasan error
local function httpGet(url)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and type(res) == "string" and #res > 0 then return res end
    local reason = ok and "respon kosong" or tostring(res)

    local getters = {
        function() return syn and syn.request end,
        function() return http_request end,
        function() return request end,
        function() return fluxus and fluxus.request end,
        function() return http and http.request end,
    }
    for _, getter in ipairs(getters) do
        local okG, fn = pcall(getter)
        if okG and type(fn) == "function" then
            local okR, r = pcall(fn, { Url = url, Method = "GET" })
            if okR and type(r) == "table" then
                if type(r.Body) == "string" and #r.Body > 0 then return r.Body end
                reason = "HTTP " .. tostring(r.StatusCode or "?")
            elseif not okR then
                reason = tostring(r)
            end
        end
    end
    return nil, reason
end

-- Warna ping: rendah = hijau, sedang = kuning, tinggi = merah (transisi halus)
local PING_GREEN, PING_YELLOW, PING_RED =
    Color3.fromRGB(48, 209, 88), Color3.fromRGB(255, 214, 10), Color3.fromRGB(255, 69, 58)
local function pingColor(ms)
    if ms <= 50 then return PING_GREEN end
    if ms <= 120 then return PING_GREEN:Lerp(PING_YELLOW, (ms - 50) / 70) end
    if ms <= 250 then return PING_YELLOW:Lerp(PING_RED, (ms - 120) / 130) end
    return PING_RED
end
local function pingHex(ms)
    local c = pingColor(ms)
    return ("#%02X%02X%02X"):format(
        math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

