-- [SMOOTH] Tween lama pada properti yang sama dibatalkan dulu, supaya
-- tidak ada tween yang saling tabrak (penyebab gerakan patah-patah).
local activeTweens = setmetatable({}, { __mode = "k" })

local function tw(o, t, props, style, dir)
    if not o then return end
    if not t or t <= 0 then
        for k, v in pairs(props) do o[k] = v end
        return
    end
    local list = activeTweens[o]
    if not list then
        list = {}
        activeTweens[o] = list
    end
    for i = #list, 1, -1 do
        local e = list[i]
        local overlap = false
        for k in pairs(props) do
            if e.props[k] then overlap = true break end
        end
        if overlap then
            e.tween:Cancel()
            table.remove(list, i)
        end
    end
    local tween = TweenService:Create(o,
        TweenInfo.new(t, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), props)
    local entry = { tween = tween, props = props }
    list[#list + 1] = entry
    tween.Completed:Connect(function()
        local idx = table.find(list, entry)
        if idx then table.remove(list, idx) end
    end)
    tween:Play()
    return tween
end

local function seq(points)
    local k = {}
    for i, p in ipairs(points) do k[i] = NumberSequenceKeypoint.new(p[1], p[2]) end
    return NumberSequence.new(k)
end

local function corner(o, r)
