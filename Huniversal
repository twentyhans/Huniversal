        if not pressing then tw(sc, 0.3, { Scale = 1.04 }, Enum.EasingStyle.Quint) end
    end)
    b.MouseLeave:Connect(function()
        hovering, pressing = false, false
        tw(b, 0.3, { BackgroundTransparency = baseT }, Enum.EasingStyle.Sine)
