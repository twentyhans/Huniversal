    }, Gui)
    make("UIGradient", { Rotation = 90, Transparency = seq({ { 0, 1 }, { 0.5, 0.96 }, { 1, 0.74 } }) }, Tint)

    -- Partikel bokeh melayang naik ----------------------------------------------------
    local Fx = make("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
    }, Gui)
    local bokeh = {}
    for i = 1, 18 do
        local sz = rng:NextInteger(3, 9)
        local f = make("Frame", {
            Size = UDim2.fromOffset(sz, sz), AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0,
        }, Fx)
        corner(f, PILL)
        bokeh[i] = {
            f = f, x = rng:NextNumber(), y = rng:NextNumber(),
            speed = rng:NextNumber(12, 34), base = rng:NextNumber(0.86, 0.95),
        }
    end

    -- Glow netral (putih) di belakang logo -------------------------------------------------
    local Glow = make("CanvasGroup", {
        Size = UDim2.fromOffset(400, 400), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, ICON_Y), BackgroundTransparency = 1,
        BorderSizePixel = 0, GroupTransparency = 1,
    }, Gui)
    local GlowScale = make("UIScale", {}, Glow)
    for i = 1, 8 do
        local d = 120 + i * 30
        local c = make("Frame", {
            Size = UDim2.fromOffset(d, d), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = WHITE,
            BackgroundTransparency = 0.965, BorderSizePixel = 0,
        }, Glow)
        corner(c, PILL)
    end

    -- Titik yang mengorbit logo --------------------------------------------------------------
    local orbit = {}
    for i = 1, 6 do
        local d = make("Frame", {
            Size = UDim2.fromOffset(5, 5), AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0,
        }, Fx)
        corner(d, PILL)
        orbit[i] = d
    end

    -- Logo: buah bergaya apel yang tersusun dari huruf "H" (kiri) dan "U" (kanan) ------------
    -- Dirancang di kotak 100 x 100, lalu dikalikan K. Ubah K untuk memperbesar / memperkecil.
    local K = 1.25
    local FRUIT = Color3.fromRGB(244, 247, 252) -- warna buah
    local LEAF = Color3.fromRGB(88, 214, 120)   -- warna daun

    local IconG = make("CanvasGroup", {
        Size = UDim2.fromOffset(190, 190), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, ICON_Y), BackgroundTransparency = 1,
        BorderSizePixel = 0, GroupTransparency = 1,
    }, Gui)
    local IconScale = make("UIScale", { Scale = 0.4 }, IconG)
    local Fruit = make("Frame", {
        Size = UDim2.fromOffset(100 * K, 100 * K), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0,
    }, IconG)

    local function bar(x, y, w, h, r, color)
        local f = make("Frame", {
            Size = UDim2.fromOffset(w * K, h * K), Position = UDim2.fromOffset(x * K, y * K),
            BackgroundColor3 = color or FRUIT, BorderSizePixel = 0,
        }, Fruit)
        corner(f, UDim.new(0, r * K))
        return f
    end

    -- Monogram "HU" menyatu: H dan U berbagi satu batang tengah (kotak 84 x 100, digeser 8 agar di tengah)
    -- Semua bentuk berupa kotak bersudut bulat (tanpa clipping) supaya aman saat diputar.
    local OX = 8
    bar(OX + 0, 0, 16, 100, 8)          -- batang kiri H
    bar(OX + 16, 42, 18, 16, 0)         -- palang H
    bar(OX + 34, 0, 16, 100, 8)         -- batang tengah (kanan H + kiri U)
    bar(OX + 68, 0, 16, 100, 8)         -- batang kanan U
    bar(OX + 34, 84, 50, 16, 8)         -- dasar U

    -- Progress bar + status ---------------------------------------------------------------------------------
    local BarG = make("CanvasGroup", {
        Size = UDim2.fromOffset(320, 48), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, BAR_Y + 14), BackgroundTransparency = 1,
