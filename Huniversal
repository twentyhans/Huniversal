    rim(Hist, 1, 45, true)
    make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, Hist)
    make("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }, Hist)

    local function refreshHist()
        for _, c in ipairs(Hist:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        local list = CONFIG.SearchHistory
        for i, q in ipairs(list) do
            local b = make("TextButton", {
                Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, Text = "   ↺   " .. q,
                TextColor3 = "@TEXT", TextSize = 12, Font = F.Medium, AutoButtonColor = false,
                TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = i,
            }, Hist)
            registerFade(b)
            b.MouseButton1Click:Connect(function()
                playClick(1.2)
                Search.Text = q
                Hist.Visible = false
            end)
        end
        if #list > 0 then
            local clr = make("TextButton", {
                Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Text = "   Hapus riwayat",
                TextColor3 = "@MUTED", TextSize = 11, Font = F.Bold, AutoButtonColor = false,
                TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 100,
            }, Hist)
            registerFade(clr)
            clr.MouseButton1Click:Connect(function()
                playClick(0.9)
                CONFIG.SearchHistory = {}
                onConfigChanged()
                refreshHist()
                Hist.Visible = false
            end)
        end
    end
    local function histWanted()
        return Search.Text == "" and #CONFIG.SearchHistory > 0 and Search:IsFocused()
            and currentCat ~= "TELEPORT"
    end
    Search.Focused:Connect(function()
        refreshHist()
        Hist.Visible = histWanted()
    end)
    Search.FocusLost:Connect(function()
        local q = Search.Text:gsub("^%s+", ""):gsub("%s+$", "")
        if q ~= "" and currentCat ~= "TELEPORT" then
            local h = CONFIG.SearchHistory
            local idx = table.find(h, q)
            if idx then table.remove(h, idx) end
            table.insert(h, 1, q)
            while #h > 5 do table.remove(h) end
            onConfigChanged()
        end
        -- jeda sebentar supaya ketukan pada riwayat sempat terbaca
        task.delay(0.15, function() Hist.Visible = false end)
    end)
    Search:GetPropertyChangedSignal("Text"):Connect(function()
        Hist.Visible = histWanted()
    end)
end
