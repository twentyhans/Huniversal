    end, function(v) log("Field of View = " .. v, "ok") end)

    hubResetUI = function()
        walkValue = 32
        walkSl.set(32, true, true)
        jumpSl.set(50, true, true)
        fovSl.set(70, true, true)
    end

    -- Search: sembunyikan baris & grup yang tidak cocok
    local function applyFilter()
        local q = Search.Text:lower()
        for _, g in ipairs(groups) do
            local any = false
            for _, r in ipairs(g.rows) do
                local vis = (q == "" or r.name:find(q, 1, true) ~= nil)
                r.frame.Visible = vis
                r.div.Visible = vis and any
                if vis then any = true end
            end
            g.header.Visible = any
            g.box.Visible = any
        end
    end
    Search:GetPropertyChangedSignal("Text"):Connect(applyFilter)
end
buildHubPage()

