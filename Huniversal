local function unload()
    pcall(Splash.destroy)
    stopFly()
    for _, fn in ipairs(extraCleanups) do pcall(fn) end
    do
        local h = getHumanoid()
        if h and (desired.speed or desired.jump) then
            h.WalkSpeed = 16
            h.UseJumpPower = true
            h.JumpPower = 50
        end
        desired.speed, desired.jump = nil, nil
    end
    setNoclip(false)
    infJumpEnabled = false
    shown = false
    pcall(function() if blurEffect then blurEffect:Destroy() end end)
    for _, c in ipairs(connections) do c:Disconnect() end
    ScreenGui:Destroy()
end

