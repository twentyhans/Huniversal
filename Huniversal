local function makeSwitch(parent, rightOffset, onChange)
    local on = false
    local trackBtn = make("TextButton", {
        Size = UDim2.fromOffset(46, 28), AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -rightOffset, 0.5, 0), BorderSizePixel = 0, Text = "",
        BackgroundColor3 = C.BTN, BackgroundTransparency = 0.72, AutoButtonColor = false,
    }, parent)
    corner(trackBtn, PILL)
    rim(trackBtn, 1, 45, true)
    local knob = make("Frame", {
        Size = UDim2.fromOffset(22, 22), Position = UDim2.new(0, 3, 0, 3),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
    }, trackBtn)
    corner(knob, PILL)
    make("UIStroke", { Color = Color3.new(0, 0, 0), Transparency = 0.88, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, knob)

    local function refresh(animate)
        local t = animate and 0.28 or 0
        tw(trackBtn, t, {
            BackgroundColor3 = on and C.ACCENT or C.BTN,
            BackgroundTransparency = on and 0.05 or 0.72,
        })
        tw(knob, t, { Position = on and UDim2.new(0, 21, 0, 3) or UDim2.new(0, 3, 0, 3) }, Enum.EasingStyle.Back)
    end
    local obj = {}
    function obj.set(v, silent)
        on = v and true or false
        refresh(true)
        if not silent and onChange then onChange(on) end
    end
    function obj.get() return on end
    trackBtn.MouseButton1Click:Connect(function() obj.set(not on) end)
    table.insert(themeHooks, function() refresh(false) end)
    return obj
end

