-- AUDIO INTRO (musik sendiri lewat CONFIG.IntroSoundId, atau nada otomatis)
------------------------------------------------------------------------
local introSounds, introMusic = {}, nil

local function introPlay(id, vol, pitch)
    local s = Instance.new("Sound")
    s.Name = "HUniversalIntro"
    s.SoundId = id
    s.Volume = vol
    s.PlaybackSpeed = pitch or 1
    s.Parent = SoundService
    introSounds[s] = true
    s.Ended:Connect(function()
        introSounds[s] = nil
        s:Destroy()
    end)
    s:Play()
    task.delay(20, function()
        introSounds[s] = nil
        pcall(function() s:Destroy() end)
    end)
    return s
end

local function introId()
    local id = tostring(CONFIG.IntroSoundId or "")
    if id:match("^%d+$") then id = "rbxassetid://" .. id end
    return id
end

-- satu nada pendek dari ClickSoundId (dipakai bila tidak ada musik sendiri)
local function introNote(pitch, vol, delay)
    task.delay(delay or 0, function()
        if not CONFIG.IntroSound or not ScreenGui.Parent then return end
        pcall(introPlay, CONFIG.ClickSoundId, vol, pitch)
    end)
end

local function introStart()
    if not CONFIG.IntroSound then return end
    local vol = CONFIG.IntroSoundVolume
    local id = introId()
    pcall(function()
        if id ~= "" then
            introMusic = introPlay(id, 0, 1)
            tw(introMusic, 1, { Volume = vol }, Enum.EasingStyle.Sine)
        else
            -- nada naik selama progress bar terisi
            local pitches = { 0.8, 0.9, 1.0, 1.15, 1.3, 1.5 }
            for i, pitch in ipairs(pitches) do
                introNote(pitch, vol * (0.35 + 0.1 * i), (i - 1) * 0.5)
            end
        end
    end)
end

local function introSheen()
    if not CONFIG.IntroSound or introId() ~= "" then return end
    local vol = CONFIG.IntroSoundVolume
    introNote(1.0, vol * 0.85, 0)
    introNote(1.26, vol * 0.85, 0.06)
    introNote(1.5, vol * 0.85, 0.12)
end

local function introFinish()
    if not CONFIG.IntroSound then return end
    if introMusic then
        -- musik memudar saat jendela muncul
        local m = introMusic
        introMusic = nil
        pcall(function() tw(m, 1.6, { Volume = 0 }, Enum.EasingStyle.Sine) end)
        task.delay(1.8, function()
            introSounds[m] = nil
            pcall(function() m:Destroy() end)
        end)
    else
        introNote(0.6, CONFIG.IntroSoundVolume, 0)
        introNote(0.9, CONFIG.IntroSoundVolume * 0.7, 0.1)
    end
end

table.insert(extraCleanups, function()
    for snd in pairs(introSounds) do pcall(function() snd:Destroy() end) end
    table.clear(introSounds)
    introMusic = nil
end)

-- Intro ala aplikasi: logo buah "HU" + progress, lalu zoom ke jendela
local INTRO_TIME = 3 -- durasi pengisian progress (detik)
local function playIntro()
    Splash.started = true
    shown = true
    visToken += 1
    scaleFrom = 0.4
    snapshot()
    animValue.Value = 0
    applyProgress(0)
    Main.Visible = false
    ScreenGui.Enabled = true
    Splash.reveal(INTRO_TIME)
    introStart()

    task.spawn(function()
        task.wait(INTRO_TIME)
        Splash.sheen(0.7)
        introSheen()
        task.wait(0.6)
        Splash.ripple()
        introFinish()
        -- Main sudah berjangkar di tengah layar, jadi cukup ditampilkan lalu di-scale
        Main.Visible = true
        Splash.dissolve(1.2)
        transition(1, 1.2, Enum.EasingStyle.Quint, function()
            scaleFrom = 0.9
            Splash.introActive = false
            applyFloat() -- tampilkan tombol melayang setelah intro selesai
        end)
        applyBlur()
    end)
end
