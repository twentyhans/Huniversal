            TextColor3 = Color3.new(1, 1, 1), TextSize = 14, Font = F.Bold,
        }, icon)
        make("TextLabel", {
            Size = UDim2.new(1, -196, 0, 18), Position = UDim2.new(0, 50, 0.5, -16),
            BackgroundTransparency = 1, Text = title, TextColor3 = "@TEXT", TextSize = 13,
            Font = F.Bold, TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, line1)
        make("TextLabel", {
            Size = UDim2.new(1, -196, 0, 13), Position = UDim2.new(0, 50, 0.5, 3),
            BackgroundTransparency = 1, Text = sub, TextColor3 = "@MUTED", TextSize = 10,
            Font = F.Medium, TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, line1)

        local entry = {
            name = (title .. " " .. sub):lower(), frame = row, div = div,
            title = title, group = g, order = n, pinned = false,
        }
        -- lencana bintang (muncul saat disematkan) + area ketuk di ikon
        if pin then
            local star = make("TextLabel", {
                Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, 5, 0, -5), BackgroundColor3 = Color3.fromRGB(255, 204, 0),
