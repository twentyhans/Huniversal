    corner(iconGloss, UDim.new(0, 26))
    make("UIGradient", { Rotation = 90, Transparency = seq({ { 0, 0.68 }, { 1, 1 } }) }, iconGloss)
    local hShadow = make("TextLabel", {
        Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(0, 3), BackgroundTransparency = 1,
        Text = "H", TextColor3 = Color3.fromRGB(8, 24, 80), TextTransparency = 0.5,
