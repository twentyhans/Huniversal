local TOAST_STYLE = {
    ok   = { "✓", Color3.fromRGB(52, 199, 89) },
    err  = { "✕", Color3.fromRGB(255, 69, 58) },
    warn = { "!", Color3.fromRGB(255, 204, 0) },
    info = { "i", Color3.fromRGB(10, 132, 255) },
}
local TOAST_W, TOAST_H, TOAST_GAP, TOAST_MAX = 300, 44, 8, 3
local toastList, lastToast = {}, { msg = "", at = 0 }

local function toastTargetY(i)
    return 12 + (i - 1) * (TOAST_H + TOAST_GAP)
end
local function layoutToasts()
    for i, t in ipairs(toastList) do
        tw(t.frame, 0.4, { Position = UDim2.new(0.5, 0, 0, toastTargetY(i)) }, Enum.EasingStyle.Quint)
    end
end
local function dismissToast(t)
    local idx = table.find(toastList, t)
    if not idx then return end
    table.remove(toastList, idx)
    tw(t.frame, 0.35, {
        Position = UDim2.new(0.5, 0, 0, -TOAST_H - 16), GroupTransparency = 1,
    }, Enum.EasingStyle.Quint)
    task.delay(0.45, function() pcall(function() t.frame:Destroy() end) end)
    layoutToasts()
end

local function toast(msg, kind, dur)
    if not CONFIG.Toast or Splash.introActive or not ScreenGui.Enabled then return end
    msg = tostring(msg)
    local now = os.clock()
    if msg == lastToast.msg and now - lastToast.at < 0.8 then return end
    lastToast.msg, lastToast.at = msg, now

    local st = TOAST_STYLE[kind] or TOAST_STYLE.info
    local f = make("CanvasGroup", {
        Name = "Toast", Size = UDim2.fromOffset(TOAST_W, TOAST_H), AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, -TOAST_H - 16), BackgroundColor3 = "@BG",
        BackgroundTransparency = 0.12, BorderSizePixel = 0, GroupTransparency = 1, ZIndex = 100,
    }, ScreenGui)
    corner(f, UDim.new(0, 22))
    rim(f, 1.2, 45, false)
    local ic = make("Frame", {
        Size = UDim2.fromOffset(24, 24), Position = UDim2.new(0, 10, 0.5, -12),
        BackgroundColor3 = st[2], BorderSizePixel = 0,
    }, f)
    corner(ic, PILL)
    make("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = st[1],
        TextColor3 = Color3.new(1, 1, 1), TextSize = 13, Font = F.Bold,
    }, ic)
    make("TextLabel", {
        Size = UDim2.new(1, -52, 1, 0), Position = UDim2.new(0, 42, 0, 0),
        BackgroundTransparency = 1, Text = msg, TextColor3 = "@TEXT", TextSize = 12,
        Font = F.Medium, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, f)
    local hit = make("TextButton", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
    }, f)

    local t = { frame = f }
    table.insert(toastList, 1, t)
    while #toastList > TOAST_MAX do dismissToast(toastList[#toastList]) end
    layoutToasts()
    tw(f, 0.35, { GroupTransparency = 0 }, Enum.EasingStyle.Sine)
    hit.MouseButton1Click:Connect(function() dismissToast(t) end)
    task.delay(dur or 2.6, function() dismissToast(t) end)
end

