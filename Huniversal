    corner(btn, UDim.new(0, 13))
    local st = make("UIStroke", {
        Color = "@WHITE", Thickness = 1, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, btn)

    -- ikon ala app icon iOS
    local icon = make("Frame", {
        Size = UDim2.fromOffset(26, 26), Position = UDim2.new(0, 8, 0.5, -13),
        BackgroundColor3 = iconColor, BorderSizePixel = 0,
    }, btn)
    corner(icon, UDim.new(0, 8))
    make("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new(iconColor:Lerp(Color3.new(1, 1, 1), 0.28), iconColor),
    }, icon)
    make("UIStroke", { Color = Color3.new(1, 1, 1), Transparency = 0.75, Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, icon)
    make("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = glyph,
        TextColor3 = Color3.new(1, 1, 1), TextSize = 14, Font = F.Bold,
    }, icon)

    local label = make("TextLabel", {
        Size = UDim2.new(1, -46, 1, 0), Position = UDim2.new(0, 42, 0, 0),
        BackgroundTransparency = 1, Text = name, TextColor3 = C.MUTED, TextSize = 13,
        Font = F.Bold, TextXAlignment = Enum.TextXAlignment.Left,
    }, btn)

    btn.MouseButton1Click:Connect(function() selectTab(name) end)
    btn.MouseEnter:Connect(function()
        if currentTab ~= name then tw(label, 0.15, { TextColor3 = C.TEXT }) end
    end)
    btn.MouseLeave:Connect(function()
        if currentTab ~= name then tw(label, 0.2, { TextColor3 = C.MUTED }) end
    end)
    tabs[name] = { btn = btn, stroke = st, label = label }
    pages[name] = page()
    return pages[name]
end

