}, Main)
for i = 1, 3 do
    local off = 5 + i * 3.4
    local l = make("Frame", {
        Size = UDim2.fromOffset(3 + i * 3, 2), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(1, -off, 1, -off), Rotation = -45,
        BackgroundColor3 = "@MUTED", BackgroundTransparency = 0.35, BorderSizePixel = 0,
    }, Grip)
    corner(l, PILL)
end
do
    local resizing, startPos, startW, startH, startMainPos = false, nil, WIN_W, WIN_H, nil
    Grip.InputBegan:Connect(function(input)
        if minimized then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            resizing = true
            startPos, startW, startH, startMainPos = input.Position, WIN_W, WIN_H, Main.Position
        end
    end)
    track(UserInputService.InputChanged:Connect(function(input)
        if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local sc = math.max(MainScale.Scale, 0.1)
            local d = (input.Position - startPos) / sc
            local nw = math.clamp(math.floor(startW + d.X), MIN_W, MAX_W)
            local nh = math.clamp(math.floor(startH + d.Y), MIN_H, MAX_H)
            WIN_W, WIN_H = nw, nh
            Main.Size = UDim2.new(0, nw, 0, nh)
            -- jaga pojok kiri atas tetap di tempat (Main berjangkar di tengah)
            Main.Position = startMainPos + UDim2.fromOffset((nw - startW) / 2 * sc, (nh - startH) / 2 * sc)
            if animValue.Value > 0.99 then MainScale.Scale = fitScale() end
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if resizing and (input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch) then
            resizing = false
            onConfigChanged()
        end
    end))
    -- sembunyikan pegangan saat jendela diminimalkan
    MinBtn.MouseButton1Click:Connect(function()
        task.defer(function() Grip.Visible = not minimized end)
